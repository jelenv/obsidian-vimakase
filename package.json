{
	"name": "vimakase",
	"version": "0.2.1",
	"description": "Opinionated LazyVim-style keyboard setup for Obsidian: space leader keys and a neo-tree-style file explorer.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "npm run lint && npm run build",
		"link:dev": "node scripts/link-dev.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"prepare": "git config core.hooksPath .githooks || true"
	},
	"keywords": [
		"obsidian",
		"vim",
		"lazyvim",
		"neo-tree",
		"keyboard"
	],
	"author": "Vilem Jelen",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.2",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"obsidian": "1.13.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.70.0"
	}
}
